{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asi-agent.local/specs/signed-checkpoint.schema.json",
  "title": "ASI Agent Signed Bloodline Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["material", "algorithm", "key_id", "signature_hex"],
  "properties": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ledger_sha256",
        "events",
        "last_event_hash",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "asi.bloodline-checkpoint-material.v0.1" },
        "ledger_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "events": { "type": "integer", "minimum": 0 },
        "last_event_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "algorithm": { "const": "Ed25519" },
    "key_id": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "signature_hex": { "type": "string", "pattern": "^[a-f0-9]{128}$" }
  }
}
